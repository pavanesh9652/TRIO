# Left blank on purpose: the app calls "/api" on its own origin and the Vite dev
# server proxies it to the backend (see vite.config.js), so there is no CORS at all.
# Set this to a full URL (e.g. https://api.example.com/api) when the frontend is
# deployed separately from the API.
VITE_API_URL=

# Where the dev proxy forwards /api requests.
API_PROXY_TARGET=http://localhost:5000
